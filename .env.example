# Copy to .env and adjust as needed (the app reads plain environment variables).

# Interface and port
HOST=127.0.0.1
PORT=8000

# Public base URL of this instance (used in Telegram messages)
# PUBLIC_URL=https://your-domain.example

# Where finished files are stored
DATA_DIR=./data
# DOWNLOAD_DIR=./data/downloads

# How many downloads may run at the same time
MAX_CONCURRENT_JOBS=3

# Network timeout in seconds
REQUEST_TIMEOUT=45

# Require this token on every /api call (leave empty to disable)
# API_TOKEN=

# Authentication helpers for sites that need a logged-in session
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=./data/cookies.txt

# Outbound proxy
# PROXY=http://127.0.0.1:8080

# --- optional MongoDB job history -----------------------------------------
# Leave empty to keep the history in memory only.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=universal_downloader
# MONGO_COLLECTION=jobs

# --- optional Telegram bot -------------------------------------------------
# Get a token from @BotFather. The bot starts automatically when this is set.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwx
# Restrict the bot to specific chat ids (comma separated). Empty = everyone.
# TELEGRAM_ALLOWED_CHATS=123456789,-1001234567890
# TELEGRAM_MAX_UPLOAD_MB=50

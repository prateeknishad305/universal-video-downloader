# Copy to .env and adjust as needed (the app reads plain environment variables).

# Interface and port
HOST=127.0.0.1
PORT=8000

# Public base URL of this instance (used in Telegram messages)
# PUBLIC_URL=https://your-domain.example

# Where finished files are stored
DATA_DIR=./data
# DOWNLOAD_DIR=./data/downloads

# How many downloads may run at the same time
MAX_CONCURRENT_JOBS=3

# Network timeout in seconds
REQUEST_TIMEOUT=45

# Require this token on every /api call (leave empty to disable)
# API_TOKEN=

# Authentication helpers for sites that need a logged-in session
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=./data/cookies.txt

# Outbound proxy
# PROXY=http://127.0.0.1:8080

# --- browser automation -----------------------------------------------------
# A real browser is used for links that only open when their JavaScript
# challenge has been executed. Point UVD_BROWSER_EXECUTABLE at a Chromium
# build when it is not installed in one of the usual places.
# UVD_BROWSER_EXECUTABLE=/usr/bin/chromium
# Set to 0 to watch the browser window (needs a display, for example Xvfb).
UVD_BROWSER_HEADLESS=1
# Profile that keeps the cookies a challenge hands out.
# UVD_BROWSER_PROFILE=./data/browser-profile
# UVD_BROWSER_TIMEOUT_MS=45000
# Set to 0 to run without the browser route. Chromium needs about 500 MB of
# memory, so a small host (Render free tier) should keep this off.
# UVD_BROWSER_ENABLED=0

# Files below this size are treated as a placeholder instead of the episode.
# UVD_MIN_MEDIA_BYTES=16384

# --- limits for small hosts (Render and friends) ---------------------------
# Largest file that may be downloaded, in MB. 0 means no limit.
# UVD_MAX_FILE_MB=2048
# How many finished jobs are kept in memory.
# UVD_MAX_HISTORY_JOBS=200
# Free space (MB) that has to stay available for a new download.
# UVD_MIN_FREE_DISK_MB=256
# How many threads ffmpeg may use while merging.
# UVD_FFMPEG_THREADS=2

# --- optional MongoDB job history -----------------------------------------
# Leave empty to keep the history in memory only.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=universal_downloader
# MONGO_COLLECTION=jobs

# --- optional Telegram bot -------------------------------------------------
# Get a token from @BotFather. The bot starts automatically when this is set.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwx
# Restrict the bot to specific chat ids (comma separated). Empty = everyone.
# TELEGRAM_ALLOWED_CHATS=123456789,-1001234567890
# TELEGRAM_MAX_UPLOAD_MB=50
